# Port for the Express server to listen on (Render will automatically set this)
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas connection URL)
MONGODB_URI=mongodb://127.0.0.1:27017/attendance

# Secret key used for signing JWTs (must be a strong secret in production and match the frontend JWT_SECRET)
JWT_SECRET=super-secret-key-for-attendance-app

# JWT Expiration Time
JWT_EXPIRES=24h

# Frontend Client URL (e.g. your Vercel deployment domain)
CLIENT_URL=http://localhost:3000

# Environment mode (production, development, testing)
NODE_ENV=development

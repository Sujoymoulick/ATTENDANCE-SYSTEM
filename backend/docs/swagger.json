{
  "openapi": "3.0.3",
  "info": {
    "title": "Attendance Management System REST API",
    "description": "API documentation for the modern Attendance Management System.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate User & Get Cookie",
        "description": "Logs in user using email and password, setting an HttpOnly cookie 'token'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "admin@test.com" },
                  "password": { "type": "string", "example": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successfully logged in" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout User",
        "description": "Clears the authentication token cookie.",
        "responses": {
          "200": { "description": "Successfully logged out" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get logged in user profile",
        "responses": {
          "200": { "description": "Profile data retrieved" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get paginated users (Admin only)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "role", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of users" }
        }
      },
      "post": {
        "summary": "Create user (Admin only)",
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/users/bulk-upload": {
      "post": {
        "summary": "Bulk student upload from CSV (Admin only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csvText": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Bulk processing completed" }
        }
      }
    },
    "/attendance/bulk": {
      "post": {
        "summary": "Bulk mark class attendance (Teacher only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": { "type": "string" },
                  "date": { "type": "string", "format": "date" },
                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "student": { "type": "string" },
                        "status": { "type": "string", "enum": ["Present", "Absent", "Late"] },
                        "remarks": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Attendance saved" }
        }
      }
    }
  }
}
